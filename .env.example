# Deployed AegisReliefEscrow.sol Smart Contract Address
NEXT_PUBLIC_CONTRACT_ADDRESS="0x8A791620dd6260079BF849Dc5567aDC3F2FdC318"

# Network Chain ID (80002 for Polygon Amoy)
NEXT_PUBLIC_CHAIN_ID=80002

# Fallback ECDSA Signing Keys (Pre-configured developer keys for zero-config testing)
