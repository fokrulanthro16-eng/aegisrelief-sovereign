# -----------------------------------------------------------------------------
# AEGISRELIEF SOVEREIGN PROTOCOL - ENVIRONMENT CONFIGURATION TEMPLATE
# -----------------------------------------------------------------------------
# Copy this file to .env.local and add your API keys.
# When keys are omitted, AegisRelief automatically falls back to deterministic
# multi-oracle cryptographic verification so the application runs out-of-the-box.
# -----------------------------------------------------------------------------

# --- HETEROGENEOUS 3-MODEL AI ORACLE COMMITTEE ---

# Oracle A: Google Gemini 2.5 Flash (Vision & Spatial Forensics)
GEMINI_API_KEY="your_google_gemini_api_key_here"

# Oracle B: Hugging Face Inference API (naver-clova-ix/donut-base-finetuned-cord-v2)
HF_API_KEY="your_hugging_face_api_key_here"

# Oracle C: Nebius AI Studio (meta-llama/Llama-3.3-70B-Instruct Economic Auditor)
NEBIUS_API_KEY="your_nebius_ai_studio_api_key_here"


# --- WEB3 & SMART CONTRACT INFRASTRUCTURE ---

# EVM Testnet RPC URL (Polygon Amoy Testnet 80002 or Base Sepolia 84532)
